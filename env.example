# keep-api-gateway/.env — copy this to .env before running (dev-up.sh does this
# automatically if .env is missing). Not named .env.example: this repo's
# .gitignore excludes .env and .env.* outright.
MESSAGING_TYPE=KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Shared Postgres — MUST be the same DB ("keep") as every other service, or
# alerts ingested here never reach the event-handler/UI (split-brain).
DATABASE_CONNECTION_STRING=postgresql://keep:keep@localhost:5432/keep

# Pusher / soketi (real-time UI updates) — from docker-compose.infra.yml.
PUSHER_APP_ID=1
PUSHER_APP_KEY=keepappkey
PUSHER_APP_SECRET=keepappsecret
PUSHER_HOST=localhost
PUSHER_PORT=6001

# No-auth so ingestion needs no token.
AUTH_TYPE=NOAUTH

# Keycloak block is unused while AUTH_TYPE=NOAUTH; kept for parity.
KEYCLOAK_URL=http://localhost:8088
KEYCLOAK_REALM=keep
KEYCLOAK_ADMIN_USER=keep_admin
KEYCLOAK_ADMIN_PASSWORD=keep_admin
KEYCLOAK_CLIENT_ID=keep
KEYCLOAK_CLIENT_SECRET=keep-keycloak-secret

# SECRET — do NOT commit a real key. Replace with your own, ideally via the shell
# (export OPENAI_API_KEY=...) rather than storing it in a file under version control.
OPENAI_API_KEY=sk-REPLACE_ME
# Defaults to gpt-4o-2024-08-06
OPENAI_MODEL_NAME=gpt-5-nano-2025-08-07
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Cache (Redis) — from keep-event-handler/docker-compose.infra.yml. Port 6382,
# not the default 6379: that port is deliberately avoided in this stack's own
# infra compose (see the comment there) to not collide with any other Redis
# a dev machine might already have on 6379.
CACHE_ENABLED=true
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6382
ALERTS_CACHE_TTL=30
PROVIDERS_CACHE_TTL=120
PRESETS_CACHE_TTL=300
INCIDENTS_CACHE_TTL=60

KEEP_CORS_TRUSTED_ORIGINS=http://localhost:3000
