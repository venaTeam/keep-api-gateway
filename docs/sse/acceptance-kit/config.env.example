# Copy to config.env, fill in, then:  set -a; . ./config.env; set +a
# Nothing here is written back; the kit only reads.

# --- target environment ------------------------------------------------------
NAMESPACE=keep-integration
GATEWAY_ROUTE=https://keep-api-gateway-keep-integration.apps.example.com
GATEWAY_SELECTOR=app=keep-api-gateway     # label selecting the gateway pods
TENANT_ID=keep                            # tenant the probes subscribe to AND ingest into

# --- auth (pick ONE) ---------------------------------------------------------
# 1. a bearer token you already have
#KEEP_BEARER=eyJhbGciOi...

# 2. Keycloak password grant (the kit fetches a token itself)
KC_URL=https://keycloak-keep-integration.apps.example.com
KC_REALM=keep
KC_CLIENT_ID=keep
KC_CLIENT_SECRET=...
KC_USER=alice
KC_PASSWORD=...

# 3. noauth environments only
#KEEP_API_KEY=some-api-key

# --- the feature under test --------------------------------------------------
# Must match what the gateway/event-handler/workflows are deployed with.
SSE_NOTIFY_TOKEN=...                      # omit to skip the notify-token check
REDIS_DEPLOY=deploy/valkey                # omit to skip the Redis-restart check

# IMPORTANT: verify the tenant above is the one ingestion actually resolves to in
# this environment. On some realms `POST /alerts/event` resolves to the generic
# tenant `keep` while reads/streams resolve to the caller's org tenant; if the two
# differ, every delivery check reads as 0 for the wrong reason. Quick test:
#   POST an alert, then GET /alerts/<fingerprint> with the same auth header.
